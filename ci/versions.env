# Pinned tool versions. The single source of truth for CI tooling.
# Rules: never use floating tags; bump deliberately and re-run `make lint scan`.
# Plain KEY=VALUE, readable by POSIX sh (sourced by ci/*.sh) and by make (include).

# Docker fallback images (used when the tool is not installed locally with the pinned version).
SHELLCHECK_IMAGE=koalaman/shellcheck-alpine:v0.11.0
ACTIONLINT_IMAGE=rhysd/actionlint:1.7.12
GITLEAKS_IMAGE=zricethezav/gitleaks:v8.30.0

# Local binaries (ci/install-tools.sh and ci/lint.sh / ci/scan.sh).
# A local binary is used only when its `--version` output equals the pinned version below.
# SHA256 values are of the official release archives (linux amd64/x86_64) and are checked before install.
# actionlint and gitleaks hashes come from the release checksums files
# (actionlint_1.7.12_checksums.txt, gitleaks_8.30.0_checksums.txt).
# The shellcheck release has no checksums file in its release; its hash was computed from the downloaded
# archive (trust on first use, recorded here so later installs are checked against it).
SHELLCHECK_VERSION=0.11.0
SHELLCHECK_SHA256=b7af85e41cc99489dcc21d66c6d5f3685138f06d34651e6d34b42ec6d54fe6f6
ACTIONLINT_VERSION=1.7.12
ACTIONLINT_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
GITLEAKS_VERSION=8.30.0
GITLEAKS_SHA256=79a3ab579b53f71efd634f3aaf7e04a0fa0cf206b7ed434638d1547a2470a66e

# GitLab only: images used by .gitlab-ci.yml. Keep the same versions in .gitlab-ci.yml
# (GitLab cannot read this file).
ALPINE_IMAGE=alpine:3.21.10
DOCKER_CLI_IMAGE=docker:27.5-cli
DOCKER_DIND_IMAGE=docker:27.5-dind
